# 文件：.env.local.example
# 用途：本地开发环境变量模板，复制为 .env.local 后填写本机密钥。
# 安全：禁止提交真实密码、SMTP 授权码、JWT 密钥和第三方 API Key。

# 复制为 .env.local，本文件只用于本地开发，不提交真实值
SPRING_PROFILES_ACTIVE=dev
INSPIRE_DEMO_SEED=true
INSPIRE_DEMO_SCALE=small
INSPIRE_SESSION_LONG_LIVED_USERS=user001,user002,user003,admin

INSPIRE_DB_PASSWORD=
INSPIRE_AUTH_DB_PASSWORD=
INSPIRE_ADMIN_DB_PASSWORD=
INSPIRE_GATEWAY_DB_PASSWORD=
INSPIRE_SEARCH_DB_PASSWORD=
INSPIRE_REDIS_PASSWORD=
INSPIRE_JWT_SECRET=
INSPIRE_ADMIN_JWT_SECRET=
INSPIRE_INTERNAL_AUTH_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
INSPIRE_MAIL_USERNAME=
INSPIRE_MAIL_PASSWORD=
INSPIRE_SMS_WEBHOOK_URL=
INSPIRE_SMS_WEBHOOK_TOKEN=
INSPIRE_UNSPLASH_ACCESS_KEY=
INSPIRE_DEEPSEEK_API_KEY=
INSPIRE_DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# 网关与运行时可调项
INSPIRE_GATEWAY_RATE_LIMIT_REPLENISH=50
INSPIRE_GATEWAY_RATE_LIMIT_BURST=100
INSPIRE_AUTH_RATE_LIMIT_REPLENISH=50
INSPIRE_AUTH_RATE_LIMIT_BURST=100
INSPIRE_CORE_WRITE_RATE_LIMIT_REPLENISH=50
INSPIRE_CORE_WRITE_RATE_LIMIT_BURST=100
INSPIRE_AI_RATE_LIMIT_REPLENISH=5
INSPIRE_AI_RATE_LIMIT_BURST=10
INSPIRE_RAG_RATE_LIMIT_REPLENISH=5
INSPIRE_RAG_RATE_LIMIT_BURST=10
INSPIRE_GATEWAY_MAX_IN_MEMORY=16MB
INSPIRE_LOG_LEVEL=debug
INSPIRE_IMAGE_BACKFILL_VARIANTS=false
INSPIRE_ADMIN_JWT_EXPIRATION=315360000000

# 多模态 RAG
INSPIRE_RAG_ENABLED=true
INSPIRE_RAG_INDEX_NAME=inspire_rag_index
INSPIRE_RAG_EMBEDDING_DIMS=768
INSPIRE_RAG_EMBEDDING_BATCH_SIZE=32
INSPIRE_RAG_SYNC_BATCH_SIZE=50
INSPIRE_RAG_IMAGE_ANALYSIS_ENABLED=true
INSPIRE_RAG_OLLAMA_EMBEDDING_ENABLED=false
INSPIRE_RAG_OLLAMA_CAPTION_ENABLED=false
INSPIRE_RAG_OLLAMA_URL=http://host.docker.internal:11434
INSPIRE_RAG_EMBEDDING_MODEL=embeddinggemma:300m
INSPIRE_RAG_CAPTION_MODEL=qwen2.5vl:7b
INSPIRE_RAG_ADMIN_TOKEN=
INSPIRE_SUPPORT_RAG_ENABLED=true
INSPIRE_SUPPORT_RAG_INDEX_NAME=support_knowledge_index
INSPIRE_SUPPORT_RAG_KNOWLEDGE_FILE=docs/current/项目客服知识库.md
INSPIRE_SUPPORT_RAG_ANSWER_PROVIDER=fallback
INSPIRE_SUPPORT_RAG_OLLAMA_MODEL=deepseek-r1:8b

# 本地前端与网关地址
INSPIRE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
