# --- MinIO 对象存储 ---
INSPIRE_MINIO_ENDPOINT=http://localhost:9000
INSPIRE_MINIO_ACCESS_KEY=minioadmin
INSPIRE_MINIO_SECRET_KEY=minioadmin123
INSPIRE_MINIO_BUCKET=inspire-img

