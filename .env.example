# =============================================
# Inspire AI Preview — 环境变量文档
# 复制为 .env 或逐个 export
# =============================================

# --- DeepSeek API（AI 创作） ---
INSPIRE_DEEPSEEK_API_KEY=
INSPIRE_DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# --- Unsplash API（AI 配图） ---
INSPIRE_UNSPLASH_ACCESS_KEY=

# --- 演示数据 ---
# small=默认演示数据，large=万级压测数据
INSPIRE_DEMO_SEED=false
INSPIRE_DEMO_SCALE=small

# --- 网关限流 ---
# 默认普通接口 50 req/s，突发 100；AI 接口 5 req/s，突发 10
INSPIRE_GATEWAY_RATE_LIMIT_REPLENISH=50
INSPIRE_GATEWAY_RATE_LIMIT_BURST=100
INSPIRE_AUTH_RATE_LIMIT_REPLENISH=50
INSPIRE_AUTH_RATE_LIMIT_BURST=100
INSPIRE_CORE_WRITE_RATE_LIMIT_REPLENISH=50
INSPIRE_CORE_WRITE_RATE_LIMIT_BURST=100
INSPIRE_AI_RATE_LIMIT_REPLENISH=5
INSPIRE_AI_RATE_LIMIT_BURST=10

# --- MySQL 数据库密码（各模块独立） ---
INSPIRE_DB_PASSWORD=123456           # core
INSPIRE_AUTH_DB_PASSWORD=123456      # auth
INSPIRE_ADMIN_DB_PASSWORD=123456     # admin
INSPIRE_GATEWAY_DB_PASSWORD=123456   # gateway
INSPIRE_SEARCH_DB_PASSWORD=123456    # search

# --- JWT 密钥 ---
INSPIRE_JWT_SECRET=dGhpc0lzQURlZmF1bHRTZWNyZXRLZXlGb3JMb2NhbERldk9ubHlQbGVhc2VSZXBsYWNlSW5Qcm9k
INSPIRE_ADMIN_JWT_SECRET=dGhpc0lzQURlZmF1bHRTZWNyZXRLZXlGb3JMb2NhbERldk9ubHlQbGVhc2VSZXBsYWNlSW5Qcm9k

# --- Redis ---
INSPIRE_REDIS_PASSWORD=123456

